{
  "name": "betterbmtc",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "npm --prefix backend test",
    "typecheck": "tsc -b",
    "prebuild": "node scripts/sync-data.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm --prefix backend run typecheck && npm run test",
    "dev:api": "npm --prefix backend run dev",
    "deploy": "node scripts/deploy.mjs",
    "setup": "npm ci && npm --prefix backend ci"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "lucide-react": "^0.468.0",
    "leaflet": "^1.9.4",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "latest",
    "typescript": "^5.9.0",
    "vite": "latest",
    "vitest": "latest",
    "@playwright/test": "latest",
    "vercel": "latest"
  }
}
