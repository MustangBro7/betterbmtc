# Set to your deployed Cloudflare Worker. Include /api.
# Without this in production, the app uses the on-device static transit database.
VITE_API_URL=https://betterbmtc-api.YOUR_SUBDOMAIN.workers.dev/api
# Optional compatible raster tile provider; default is standard OpenStreetMap.
# Update TransitMap attribution when changing providers.
# VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
